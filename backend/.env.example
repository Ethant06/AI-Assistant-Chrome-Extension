# Used when you run uvicorn / alembic on Windows against Docker Postgres.
# docker compose overrides DATABASE_URL for the backend container to db:5432.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5433/study_assistant
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=
ENVIRONMENT=development
