# Purpose is to give FastAPI configuration it needs - specifically tells it where to connect to PostgreSQL when it access database
# at localhost: 5432
# Copy to backend/.env and fill in real values.
# After `docker compose up -d`, point DATABASE_URL at the container.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_assistant
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=
ENVIRONMENT=development
